{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/us-equity-research/run-result.schema.json",
  "title": "US-equity research run summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "market",
    "run_id",
    "artifact_id",
    "status",
    "writer_mode",
    "data_mode",
    "pit_quality",
    "workflow",
    "decision_at",
    "snapshot_id",
    "analysis_hash",
    "counts",
    "focus",
    "warnings",
    "gaps",
    "research_queue_count",
    "available_sections",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "market": { "const": "US" },
    "run_id": { "type": "string" },
    "artifact_id": { "type": "string" },
    "status": { "enum": ["completed", "partial"] },
    "writer_mode": { "const": "engine" },
    "data_mode": { "enum": ["fixture", "snapshot"] },
    "pit_quality": {
      "enum": ["FIXTURE", "P1", "P2", "P3", "RECONSTRUCTED_NON_PIT"]
    },
    "workflow": {
      "enum": ["daily_report", "stock_research", "theme_research"]
    },
    "decision_at": { "type": "string", "format": "date-time" },
    "snapshot_id": { "type": "string" },
    "analysis_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "counts": { "type": "object" },
    "focus": { "type": "array" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "research_queue_count": { "type": "integer", "minimum": 0 },
    "available_sections": {
      "type": "array",
      "items": { "enum": ["summary", "report", "manifest", "packet", "facts"] }
    },
    "manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reused": { "type": "boolean" }
  }
}
