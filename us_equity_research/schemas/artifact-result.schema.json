{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/us-equity-research/artifact-result.schema.json",
  "title": "US equity research artifact result",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "market", "artifact_id", "status"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "market": { "const": "US" },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$",
      "maxLength": 128
    },
    "status": { "enum": ["completed", "not_implemented"] },
    "workflow": {
      "enum": ["daily_report", "theme_research", "stock_research"]
    },
    "decision_at": { "type": "string", "format": "date-time" },
    "snapshot_id": {
      "type": "string",
      "pattern": "^(?!\\.)(?!.*\\.\\.)[A-Za-z0-9._-]{1,128}$",
      "maxLength": 128
    },
    "available_sections": {
      "type": "array",
      "items": { "enum": ["summary", "report", "manifest", "packet"] }
    }
  }
}
