{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/a-share-research/run-result.schema.json",
  "title": "A-share research run summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "market",
    "run_id",
    "artifact_id",
    "status",
    "writer_mode",
    "method_id",
    "data_mode",
    "pit_quality",
    "workflow",
    "decision_at",
    "snapshot_id",
    "analysis_hash",
    "counts",
    "focus",
    "candidate_index",
    "warnings",
    "gaps",
    "research_queue_count",
    "available_sections",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "market": { "const": "CN" },
    "run_id": { "type": "string" },
    "artifact_id": { "type": "string" },
    "status": { "const": "completed" },
    "writer_mode": { "const": "engine" },
    "method_id": { "const": "a-share-theme-v2.0" },
    "data_mode": { "enum": ["fixture", "snapshot"] },
    "pit_quality": {
      "enum": ["FIXTURE", "P1", "P2", "P3", "RECONSTRUCTED_NON_PIT"]
    },
    "workflow": {
      "enum": ["daily_report", "stock_research", "theme_research"]
    },
    "decision_at": { "type": "string", "format": "date-time" },
    "snapshot_id": { "type": "string" },
    "analysis_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "counts": { "type": "object" },
    "focus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "symbol",
          "name",
          "decision",
          "attention_score",
          "attention_bucket",
          "opportunity_view",
          "new_information",
          "economic_impact",
          "expectation_gap",
          "market_pricing"
        ],
        "properties": {
          "attention_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "attention_bucket": { "enum": ["deep_dive", "monitor", "backlog", "closed"] },
          "opportunity_view": { "enum": ["positive", "neutral", "negative", "unclear"] }
        }
      }
    },
    "candidate_index": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "symbol", "canonical_state"],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 },
          "canonical_state": { "enum": ["exclude", "continue_research", "observe"] }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "gaps": { "type": "array", "items": { "type": "string" } },
    "research_queue_count": { "type": "integer", "minimum": 0 },
    "available_sections": {
      "type": "array",
      "items": { "enum": ["summary", "report", "manifest", "packet", "facts"] }
    },
    "manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reused": { "type": "boolean" }
  }
}
