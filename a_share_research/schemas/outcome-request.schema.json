{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/a-share-research/outcome-request.schema.json",
  "title": "A-share outcome command request",
  "oneOf": [
    { "$ref": "#/$defs/record" },
    { "$ref": "#/$defs/summary" },
    { "$ref": "#/$defs/history" },
    { "$ref": "#/$defs/settleSnapshot" }
  ],
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "market",
        "run_id",
        "symbol",
        "horizon_trading_days",
        "observed_at",
        "available_at",
        "candidate_return",
        "benchmark_return",
        "benchmark_symbol",
        "source_url",
        "source_document_id"
      ],
      "properties": {
        "schema_version": { "const": "0.1" },
        "market": { "const": "CN" },
        "run_id": { "type": "string", "minLength": 1 },
        "candidate_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "symbol": { "type": "string", "minLength": 1 },
        "horizon_trading_days": { "enum": [5, 20] },
        "observed_at": { "type": "string", "format": "date-time" },
        "available_at": { "type": "string", "format": "date-time" },
        "candidate_return": { "type": "number", "minimum": -1, "maximum": 100 },
        "benchmark_return": { "type": "number", "minimum": -1, "maximum": 100 },
        "benchmark_symbol": { "const": "000906.SH" },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "source_document_id": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "market", "run_id", "evaluation_at"],
      "properties": {
        "schema_version": { "const": "0.1" },
        "market": { "const": "CN" },
        "run_id": { "type": "string", "minLength": 1 },
        "evaluation_at": { "type": "string", "format": "date-time" }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "market", "evaluation_at"],
      "properties": {
        "schema_version": { "const": "0.1" },
        "market": { "const": "CN" },
        "evaluation_at": { "type": "string", "format": "date-time" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 20, "default": 10 }
      }
    },
    "settleSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "market", "snapshot_id", "evaluation_at"],
      "properties": {
        "schema_version": { "const": "0.1" },
        "market": { "const": "CN" },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "maxLength": 128
        },
        "evaluation_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
