{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/a-share-research/research-history-request.schema.json",
  "title": "A-share candidate research-history request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "market", "evaluation_at"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "market": { "const": "CN" },
    "evaluation_at": { "type": "string", "format": "date-time" },
    "candidate_ids": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 }
  }
}
