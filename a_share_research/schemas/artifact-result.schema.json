{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/a-share-research/artifact-result.schema.json",
  "title": "A-share research artifact read result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "market",
    "artifact_id",
    "section",
    "content_type",
    "content",
    "truncated",
    "cursor",
    "next_cursor",
    "total_chars",
    "content_sha256",
    "relative_path"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "market": { "const": "CN" },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$",
      "maxLength": 128
    },
    "section": {
      "enum": ["summary", "report", "manifest", "packet", "facts"]
    },
    "content_type": {
      "enum": ["application/json", "text/markdown"]
    },
    "content": { "type": "string" },
    "truncated": { "type": "boolean" },
    "cursor": { "type": "integer", "minimum": 0 },
    "next_cursor": { "type": ["integer", "null"], "minimum": 0 },
    "total_chars": { "type": "integer", "minimum": 0 },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
    }
  }
}
