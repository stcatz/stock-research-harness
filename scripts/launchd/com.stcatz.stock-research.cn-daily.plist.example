<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stcatz.stock-research.cn-daily</string>

  <!-- Replace __ROOT__ and __SEED_JSON__ with absolute paths before loading. -->
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/scripts/run_cn_daily.sh</string>
    <string>--root</string>
    <string>__ROOT__</string>
    <string>--seed-json</string>
    <string>__SEED_JSON__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <!-- launchd weekday values: Sunday=1, Monday=2, ..., Saturday=7. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key>
      <integer>2</integer>
      <key>Hour</key>
      <integer>20</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>3</integer>
      <key>Hour</key>
      <integer>20</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>4</integer>
      <key>Hour</key>
      <integer>20</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>5</integer>
      <key>Hour</key>
      <integer>20</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>6</integer>
      <key>Hour</key>
      <integer>20</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__ROOT__/.runtime/logs/cn-daily.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/.runtime/logs/cn-daily.stderr.log</string>
</dict>
</plist>
